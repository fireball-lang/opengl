pub enum SubgroupSupportedFeatures : u32 {
    SubgroupFeatureBasicBitKhr = 0x00000001,
    SubgroupFeatureVoteBitKhr = 0x00000002,
    SubgroupFeatureArithmeticBitKhr = 0x00000004,
    SubgroupFeatureBallotBitKhr = 0x00000008,
