pub enum UseProgramStageMask : u32 {
    VertexShaderBit = 0x00000001,
    FragmentShaderBit = 0x00000002,
    GeometryShaderBit = 0x00000004,
    TessControlShaderBit = 0x00000008,
    TessEvaluationShaderBit = 0x00000010,
    ComputeShaderBit = 0x00000020,
    MeshShaderBitExt = 0x00000040,
    TaskShaderBitExt = 0x00000080,
    AllShaderBits = 0xFFFFFFFF,
}

impl UseProgramStageMask : BitNot {
    type Result = UseProgramStageMask;

    pub func bit_not(self) Self {
        return ~(*self as u32) as Self;
    }
}

impl UseProgramStageMask : BitOr[UseProgramStageMask] {
    type Result = UseProgramStageMask;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as u32 | rhs as u32) as Self;
    }
}

impl UseProgramStageMask : BitAnd[UseProgramStageMask] {
    type Result = UseProgramStageMask;

    pub func bit_and(self, rhs: Self) Self {
        return (*self as u32 & rhs as u32) as Self;
    }
}

