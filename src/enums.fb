pub enum MapBufferAccessMask : u32 {
    MapReadBit = 0x0001,
    MapWriteBit = 0x0002,
    MapInvalidateRangeBit = 0x0004,
    MapInvalidateBufferBit = 0x0008,
    MapFlushExplicitBit = 0x0010,
    MapUnsynchronizedBit = 0x0020,
    MapPersistentBit = 0x0040,
    MapCoherentBit = 0x0080,
}

impl MapBufferAccessMask : BitNot {
    type Result = MapBufferAccessMask;

    pub func bit_not(self) Self {
        return ~(*self as u32) as Self;
    }
}

impl MapBufferAccessMask : BitOr[MapBufferAccessMask] {
    type Result = MapBufferAccessMask;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as u32 | rhs as u32) as Self;
    }
}

impl MapBufferAccessMask : BitAnd[MapBufferAccessMask] {
    type Result = MapBufferAccessMask;

    pub func bit_and(self, rhs: Self) Self {
        return (*self as u32 & rhs as u32) as Self;
    }
}

