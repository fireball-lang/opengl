    SubgroupFeatureShuffleRelativeBitKhr = 0x00000020,
    SubgroupFeatureClusteredBitKhr = 0x00000040,
    SubgroupFeatureQuadBitKhr = 0x00000080,
}

impl SubgroupSupportedFeatures : BitNot {
    type Result = SubgroupSupportedFeatures;

    pub func bit_not(self) Self {
        return ~(*self as u32) as Self;
    }
}

impl SubgroupSupportedFeatures : BitOr[SubgroupSupportedFeatures] {
    type Result = SubgroupSupportedFeatures;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as u32 | rhs as u32) as Self;
    }
}

impl SubgroupSupportedFeatures : BitAnd[SubgroupSupportedFeatures] {
    type Result = SubgroupSupportedFeatures;

    pub func bit_and(self, rhs: Self) Self {
        return (*self as u32 & rhs as u32) as Self;
    }
}

