pub enum FragmentShaderDestMaskATI : u32 {
    None = 0,
}

impl FragmentShaderDestMaskATI : BitNot {
    type Result = FragmentShaderDestMaskATI;

    pub func bit_not(self) Self {
        return ~(*self as u32) as Self;
    }
}

impl FragmentShaderDestMaskATI : BitOr[FragmentShaderDestMaskATI] {
    type Result = FragmentShaderDestMaskATI;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as u32 | rhs as u32) as Self;
    }
}

impl FragmentShaderDestMaskATI : BitAnd[FragmentShaderDestMaskATI] {
    type Result = FragmentShaderDestMaskATI;

    pub func bit_and(self, rhs: Self) Self {
        return (*self as u32 & rhs as u32) as Self;
    }
}

