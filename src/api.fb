        if (opengl::Version::new(3, 0) <= api.version) api.load_3_0(fn);
        if (opengl::Version::new(3, 1) <= api.version) api.load_3_1(fn);
        if (opengl::Version::new(3, 2) <= api.version) api.load_3_2(fn);
        if (opengl::Version::new(3, 3) <= api.version) api.load_3_3(fn);
        if (opengl::Version::new(4, 0) <= api.version) api.load_4_0(fn);
        if (opengl::Version::new(4, 1) <= api.version) api.load_4_1(fn);
        if (opengl::Version::new(4, 2) <= api.version) api.load_4_2(fn);
        if (opengl::Version::new(4, 3) <= api.version) api.load_4_3(fn);
