impl Api {
    pub func load(fn: func(name: StringView) *void) ?&Api {
        var api = malloc(sizeof(Self)) as mut &Self;
        api.init_stubs();
        var ptr: *void;

        ptr = fn("glGetIntegerv");
        if (ptr == null) return Option:[&Self]::none();
        api.ref_get_integerv = ptr as opengl::GlGetIntegerv;

        ptr = fn("glGetStringi");
        if (ptr == null) return Option:[&Self]::none();
        api.ref_get_stringi = ptr as opengl::GlGetStringi;

        var major: i32;
        api.get_integerv(opengl::GetPName::MajorVersion, &major);
        if (major < 1 || major > 255) return Option:[&Self]::none();
        api.version.major = major as u8;

        var minor: i32;
        api.get_integerv(opengl::GetPName::MinorVersion, &minor);
        if (minor < 0 || minor > 255) return Option:[&Self]::none();
        api.version.minor = minor as u8;

        if (opengl::Version::new(1, 0) <= api.version) api.load_1_0(fn);
        if (opengl::Version::new(1, 1) <= api.version) api.load_1_1(fn);
        if (opengl::Version::new(1, 2) <= api.version) api.load_1_2(fn);
